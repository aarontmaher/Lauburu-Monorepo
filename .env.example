# Lauburu writer env — placeholders only.
#
# Copy this file to .env.local OR run `npm run setup:supabase`
# (preferred — does the paste safely with hidden input + validation).
#
# Required by npm run bridge:snapshot to upsert connector_* tables
# in Supabase. Service-role keys bypass RLS, so keep .env.local
# laptop-local — never commit, never paste into mobile / public /
# CI / chat.

# Supabase project URL (looks like https://<project-ref>.supabase.co).
SUPABASE_URL=

# Supabase service-role secret. Either modern sb_secret_* or
# legacy JWT (eyJ...) form. Same value goes into SUPABASE_SECRET_KEY
# below for forward-compat with newer clients.
SUPABASE_SERVICE_ROLE_KEY=

# Newer Supabase clients call the same value SUPABASE_SECRET_KEY.
# Setting it here keeps the existing bridge writers and any newer
# helper happy; the value is identical to the line above.
SUPABASE_SECRET_KEY=
