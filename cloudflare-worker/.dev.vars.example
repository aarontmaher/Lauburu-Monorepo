# Cloudflare Worker local env template — copy to .dev.vars and
# replace the placeholder values. .dev.vars is gitignored; this
# .example file is committed.
#
# Wrangler reads .dev.vars when you run `npm run dev` and exposes
# each line as a binding inside Env.

# Same shared admin token used by the Railway backend and the
# mobile app. Mint a fresh value with:
#   openssl rand -hex 24
# and set the SAME value in:
#   - Railway → service → Variables (ATHLETE_MEMORY_API_TOKEN)
#   - This file (.dev.vars) for local Worker dev
#   - Cloudflare secret for preview env via:
#       npx wrangler secret put ATHLETE_MEMORY_API_TOKEN --env preview
ATHLETE_MEMORY_API_TOKEN="REPLACE_WITH_REAL_TOKEN"

# Supabase reads are deferred until the schema mirror lands per
# docs/CLOUDFLARE_MIGRATION.md §13 Stage 3. Leave the values
# unset for now — the Worker handler treats them as
# `supabaseConfigured: false` and returns repo-only metadata.
# When wired:
# SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SERVICE_ROLE_KEY"
