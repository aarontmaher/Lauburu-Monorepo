# Lauburu Mobile — Environment Variables
#
# Copy to .env.development (dev) or .env.production (prod).
# Expo loads EXPO_PUBLIC_* vars at build time.

# AI backend internal URL (for health/nutrition/HIIT ingest)
# Deployed: https://lauburu-ai-backend-production.up.railway.app/v1/internal
# Local simulator: http://localhost:3000/v1/internal
# Device on LAN: http://192.168.1.X:3000/v1/internal
EXPO_PUBLIC_AI_BACKEND_URL=https://lauburu-ai-backend-production.up.railway.app/v1/internal

# AI backend public URL (for /ai-context, /coach/ask, /health-check)
# Deployed: https://lauburu-ai-backend-production.up.railway.app/api/athlete-memory
EXPO_PUBLIC_AI_PUBLIC_URL=https://lauburu-ai-backend-production.up.railway.app/api/athlete-memory

# Internal API token (matches INTERNAL_API_TOKEN on backend)
EXPO_PUBLIC_INTERNAL_API_TOKEN=

# Athlete memory API token (matches ATHLETE_MEMORY_API_TOKEN on backend)
EXPO_PUBLIC_ATHLETE_MEMORY_TOKEN=

# Default athlete ID (from auth or env)
EXPO_PUBLIC_ATHLETE_ID=dev-athlete

# WHOOP bridge owner allowlist — comma-separated Supabase user.id(s).
# Only these accounts will fetch the Supabase WHOOP bridge, which is a
# single-user proxy. Leave unset to fall back to 'dev-athlete'.
EXPO_PUBLIC_WHOOP_BRIDGE_OWNER_IDS=
