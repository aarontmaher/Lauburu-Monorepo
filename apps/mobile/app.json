{
  "expo": {
    "name": "Lauburu Grappling Map",
    "slug": "lauburu-grappling-map",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lauburu",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lauburu.grapplingmap",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Lauburu reads your health data to track recovery, sleep, and training readiness alongside your grappling progress.",
        "NSHealthUpdateUsageDescription": "Lauburu can log grappling sessions to your Health data."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.lauburu.grapplingmap"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Lauburu reads your health data to track recovery, sleep, and training readiness alongside your grappling progress.",
          "NSHealthUpdateUsageDescription": "Lauburu can log grappling sessions to your Health data."
        }
      ],
      "expo-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
