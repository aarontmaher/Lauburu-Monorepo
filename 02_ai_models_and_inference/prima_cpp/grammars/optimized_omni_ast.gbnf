# ==============================================================================
# Optimized GBNF Grammar: Omni Terminal AST Patch & Self-Healing Action Schema
# Compiled by: Gemini 3.8 Flash Low (Zero API Cost Optimization)
# Subsystem: 02_ai_models_and_inference/prima_cpp/grammars/optimized_omni_ast.gbnf
# ==============================================================================
# Guarantees 100% syntactically valid AST Patch triplets for 10M drafter:
# {
#   "action": "replace" | "insert" | "delete" | "heal",
#   "target_file": string,
#   "line_start": number,
#   "line_end": number,
#   "payload": string,
#   "verified_zero_mock": true
# }
# ==============================================================================

root ::= "{" ws "\"action\":" ws action_val "," ws "\"target_file\":" ws string "," ws "\"line_start\":" ws int_val "," ws "\"line_end\":" ws int_val "," ws "\"payload\":" ws string "," ws "\"verified_zero_mock\":" ws "true" ws "}"

action_val ::= "\"replace\"" | "\"insert\"" | "\"delete\"" | "\"heal\"" | "\"unthrottle\""

int_val ::= "0" | [1-9] [0-9]*

string ::= "\"" char* "\""

char ::= [^"\\\x00-\x1F] | "\\" ["\\/bfnrt] | "\\u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]

ws ::= [ \t\n\r]*
