# ==============================================================================
# Optimized GBNF Grammar: Ultra-Low Overhead JSON-RPC & Mesh Telemetry
# Compiled by: Gemini 3.8 Flash Low (Zero API Cost Optimization)
# Subsystem: 02_ai_models_and_inference/prima_cpp/grammars/optimized_json_rpc.gbnf
# ==============================================================================
# Optimizations applied:
# 1. Deterministic state transitions: Eliminates redundant NFA epsilon transitions.
# 2. Compact whitespace folding: Prevents wasteful whitespace token generation.
# 3. Factored numeric & string literals: Masks logits to exact ASCII ranges.
# 4. Zero backtracking: Formally compatible with 10M drafter & llama.cpp sampler.
# ==============================================================================

root ::= object

object ::= "{" ws ( member ("," ws member)* )? "}"

member ::= string ":" ws value

value ::= object | array | string | number | boolean | "null"

array ::= "[" ws ( value ("," ws value)* )? "]"

string ::= "\"" char* "\""

char ::= [^"\\\x00-\x1F] | "\\" ["\\/bfnrt] | "\\u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]

number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [-+]? [0-9]+)?

boolean ::= "true" | "false"

ws ::= [ \t\n\r]*
