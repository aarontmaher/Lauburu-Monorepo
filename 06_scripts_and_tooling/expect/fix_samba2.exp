#!/usr/bin/expect -f
set timeout 15
spawn ssh -o StrictHostKeyChecking=no linux@100.101.39.98
expect "assword:"
send "goldfighting1\r"
expect "\\$"
send "cd ~/nas_samba && echo 'goldfighting1' | sudo -S docker-compose up -d\r"
expect "\\$"
send "echo 'goldfighting1' | sudo -S docker ps | grep samba\r"
expect "\\$"
send "exit\r"
