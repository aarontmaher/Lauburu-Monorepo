#!/usr/bin/expect -f
set timeout 15
spawn ssh -o StrictHostKeyChecking=no root@192.168.8.1
expect "*?assword:*"
send "Goldfighting1\r"
expect "*?root@*"
send "uci set network.tethering.ifname='usb0'\r"
expect "*?root@*"
send "uci commit network\r"
expect "*?root@*"
send "ifup tethering\r"
expect "*?root@*"
send "exit\r"
