#!/usr/bin/expect -f
set timeout 30

# Copy docker-compose.samba.yml to Linux
spawn scp -o StrictHostKeyChecking=no docker/docker-compose.samba.yml linux@100.101.39.98:/tmp/
expect "assword:"
send "goldfighting1\r"
expect eof

# Run docker-compose
spawn ssh -o StrictHostKeyChecking=no linux@100.101.39.98
expect "assword:"
send "goldfighting1\r"
expect "\\$"

# Create smb config
send "sudo bash -c 'echo -e \"\[nas\]\npath = /data\nbrowseable = yes\nread only = no\nguest ok = yes\" > /Volumes/Lauburu-Monorepo/smb_pool_config.conf'\r"
expect "assword"
send "goldfighting1\r"
expect "\\$"

send "mkdir -p ~/nas_samba && mv /tmp/docker-compose.samba.yml ~/nas_samba/docker-compose.yml && cd ~/nas_samba\r"
expect "\\$"
send "sudo docker-compose up -d\r"
expect "\\$"
send "sudo docker ps | grep samba\r"
expect "\\$"
send "exit\r"
