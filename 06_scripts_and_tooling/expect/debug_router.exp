#!/usr/bin/expect -f
set timeout 15
spawn ssh -o StrictHostKeyChecking=no root@192.168.8.1
expect "*?assword:*"
send "Goldfighting1\r"
expect "*?root@*"
send "dmesg | grep -i usb | tail -n 20\r"
expect "*?root@*"
send "lsusb\r"
expect "*?root@*"
send "cat /etc/config/network | grep -i tether\r"
expect "*?root@*"
send "exit\r"
