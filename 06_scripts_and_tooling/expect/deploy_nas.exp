#!/usr/bin/expect -f
set timeout 30

# Copy docker-compose
spawn scp -o StrictHostKeyChecking=no infrastructure/nas_core/docker-compose.yml linux@100.101.39.98:/tmp/
expect "assword:"
send "goldfighting1\r"
expect eof

# Run docker compose
spawn ssh -o StrictHostKeyChecking=no linux@100.101.39.98
expect "assword:"
send "goldfighting1\r"
expect "\\$"
send "mkdir -p ~/nas_core && mv /tmp/docker-compose.yml ~/nas_core/ && cd ~/nas_core\r"
expect "\\$"
send "sudo docker compose up -d\r"
expect "assword"
send "goldfighting1\r"
expect "\\$"
send "sudo docker ps | grep nfs\r"
expect "\\$"
send "exit\r"
