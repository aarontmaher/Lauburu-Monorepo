#!/usr/bin/expect -f
set timeout 30

spawn ssh -o StrictHostKeyChecking=no linux@100.101.39.98
expect "assword:"
send "goldfighting1\r"
expect "\\$"
send "cd ~/nas_core && sudo docker-compose up -d\r"
expect "assword"
send "goldfighting1\r"
expect "\\$"
send "sudo docker ps | grep nfs\r"
expect "\\$"
send "exit\r"
