FROM docker.io/library/debian:13-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV GBOS_JOBS=4

# Install compilation toolchain, amd64 multiarch runtime for NDK x86_64 host tools on arm64, JDK 21, Python packages, and utilities
RUN dpkg --add-architecture amd64 && apt-get update && apt-get install -y \
    libc6:amd64 \
    zlib1g:amd64 \
    libstdc++6:amd64 \
    build-essential \
    openjdk-21-jdk-headless \
    git \
    python3 \
    python3-pip \
    python3-venv \
    python3-mako \
    python3-yaml \
    python3-packaging \
    meson \
    ninja-build \
    pkg-config \
    libdrm-dev \
    libx11-dev \
    libxext-dev \
    libxfixes-dev \
    libelf-dev \
    bison \
    flex \
    patch \
    libdigest-sha-perl \
    xz-utils \
    curl \
    wget \
    unzip \
    && ln -s /usr/lib/jvm/java-21-openjdk-* /usr/lib/jvm/java-21-openjdk \
    && rm -rf /var/lib/apt/lists/*

# Android Toolchain Environment Variables
ENV ANDROID_SDK=/opt/android-sdk
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV ANDROID_NDK=/opt/android-sdk/ndk/28.2.13676358
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk
ENV PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/build-tools/36.0.0:/opt/android-sdk/platform-tools:$PATH

# Install Android Command-Line Tools, SDK Platform 36, Build-Tools 36.0.0, and NDK r28c
RUN mkdir -p /opt/android-sdk/cmdline-tools /opt/android-sdk/ndk && \
    curl -fL -o /tmp/cmdline-tools.zip https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip && \
    unzip -q /tmp/cmdline-tools.zip -d /opt/android-sdk/cmdline-tools && \
    mv /opt/android-sdk/cmdline-tools/cmdline-tools /opt/android-sdk/cmdline-tools/latest && \
    rm /tmp/cmdline-tools.zip && \
    yes | /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager --licenses >/dev/null && \
    /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager "build-tools;36.0.0" "platforms;android-36" >/dev/null && \
    curl -fL -o /tmp/ndk.zip https://dl.google.com/android/repository/android-ndk-r28c-linux.zip && \
    unzip -q /tmp/ndk.zip -d /opt/android-sdk/ndk && \
    mv /opt/android-sdk/ndk/android-ndk-r28c /opt/android-sdk/ndk/28.2.13676358 && \
    rm /tmp/ndk.zip

WORKDIR /workspace

CMD ["/bin/bash", "-c", "if [ -f build-guest.sh ]; then ./build-guest.sh; else echo 'Mount gbos-vm source to /workspace'; fi"]
