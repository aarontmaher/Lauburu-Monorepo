FROM docker.io/library/golang:1.23-bookworm AS builder

WORKDIR /src
COPY go.mod ./
COPY main.go ./

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o go_gatt_browser main.go

FROM docker.io/library/debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    bluez \
    dbus \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /src/go_gatt_browser /app/go_gatt_browser
COPY dashboard.html /app/dashboard.html

EXPOSE 8084
ENV PORT=8084

CMD ["/app/go_gatt_browser"]
