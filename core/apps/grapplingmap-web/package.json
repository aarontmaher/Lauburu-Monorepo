{
  "name": "@lauburu/grapplingmap-web",
  "version": "1.0.0",
  "description": "Public Lauburu Grappling Map GitHub Pages renderer and OPML export pipeline.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "playwright test tests/e2e/smoke.spec.js",
    "test:snapshots": "playwright test tests/e2e/snapshots.spec.js",
    "test:update-snapshots": "playwright test tests/e2e/snapshots.spec.js --update-snapshots",
    "test:all": "playwright test",
    "ready": "npm run test && echo '✓ All smoke tests passed — ready to deploy'",
    "check": "playwright test tests/e2e/smoke.spec.js --reporter=line"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aarontmaher/lauburu-grappling-map.git",
    "directory": "apps/grapplingmap-web"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/aarontmaher/lauburu-grappling-map/issues"
  },
  "homepage": "https://www.lauburugrapplingmap.com/",
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
