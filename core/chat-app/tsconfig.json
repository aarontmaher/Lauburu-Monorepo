{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": ".."
  },
  "include": [
    "src/**/*",
    "../packages/shared/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "src/client/**/*"
  ]
}