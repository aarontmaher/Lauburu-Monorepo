# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native builds
ios/
android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Environment — never commit real values, anywhere in the tree
.env
.env.local
.env.production
.env.development
**/.env
**/.env.local
**/.env.production
**/.env.development
# Allow committed example files only
!**/.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local QA evidence — screenshots, generated prompts, and bridge JSON drafts
tmp/

# Audit screenshot bundles produced by `npm run audit:screenshots`
artifacts/

# Claude Code workspace state — never commit
.claude/

# Stray root app.json artefact (real config lives at apps/mobile/app.json)
/app.json

# Local bridge snapshot output (regenerated by scripts/bridge-snapshot-lanes.sh)
data/agent-status/*.json
data/agent-status/lanes/

# bridge-watch.sh runtime state (cached lane status + write timestamp)
data/agent-status/lanes/.bridge-watch-state.json

# mcp-watcher.mjs runtime logs (per-tick JSONL; local-only)
data/mcp-watcher/
