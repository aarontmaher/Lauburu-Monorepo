#!/bin/sh /etc/rc.common
# ==============================================================================
# Lauburu Mesh - ARP Link State Oracle procd Service (R3)
# Subsystem: 00_core_infrastructure/router_foundation
# Target: /etc/init.d/mesh_arp_oracle
#
# Launches the background rtnetlink neighbor monitoring daemon (/usr/bin/mesh_arp_oracle.sh)
# under OpenWrt procd supervision with automatic respawn and reload triggers.
# ==============================================================================

USE_PROCD=1
START=96
STOP=10

PROG="/usr/bin/mesh_arp_oracle.sh"
NAME="mesh_arp_oracle"

extra_command "dump" "Dump current ARP neighbor table to Mac Mini ingester"

start_service() {
    [ -x "$PROG" ] || {
        logger -t "$NAME" "ERROR: $PROG is not executable."
        return 1
    }

    procd_open_instance
    procd_set_param command "$PROG" --daemon
    procd_set_param respawn 3600 5 10
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    logger -t "$NAME" "mesh_arp_oracle procd service started."
}

stop_service() {
    logger -t "$NAME" "Stopping mesh_arp_oracle procd service..."
    local pids
    pids=$(pgrep -f "$PROG" 2>/dev/null || true)
    if [ -n "$pids" ]; then
        kill -TERM $pids 2>/dev/null || true
    fi
}

dump() {
    if [ -x "$PROG" ]; then
        "$PROG" --dump-current
    else
        echo "ERROR: $PROG not executable" >&2
        return 1
    fi
}

service_triggers() {
    procd_add_reload_trigger "network"
}
