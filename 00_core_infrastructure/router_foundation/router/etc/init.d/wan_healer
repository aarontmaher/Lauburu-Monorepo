#!/bin/sh /etc/rc.common
# ==============================================================================
# Lauburu Mesh - Out-Of-Band WAN Self-Healer procd Service (R4)
# Subsystem: 00_core_infrastructure/router_foundation
# Target: /etc/init.d/wan_healer
# ==============================================================================

USE_PROCD=1
START=90
STOP=10

PROG="/usr/bin/lauburu_oob_wan_healer.sh"
NAME="wan_healer"

extra_command "status_json" "Display current WAN Healer JSON state"
extra_command "failover" "Force immediate manual failover to backup gateway"
extra_command "failback" "Force immediate manual failback to primary gateway"

start_service() {
    [ -x "$PROG" ] || {
        logger -t "$NAME" "ERROR: $PROG is not executable."
        return 1
    }

    procd_open_instance
    procd_set_param command "$PROG" --daemon
    procd_set_param respawn 3600 5 10
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    logger -t "$NAME" "wan_healer procd service started."
}

stop_service() {
    logger -t "$NAME" "Stopping wan_healer procd service..."
}

status_json() {
    if [ -x "$PROG" ]; then
        "$PROG" --status
    else
        echo "{\"error\":\"$PROG not executable\"}"
    fi
}

failover() {
    if [ -x "$PROG" ]; then
        "$PROG" --failover
    fi
}

failback() {
    if [ -x "$PROG" ]; then
        "$PROG" --failback
    fi
}

service_triggers() {
    procd_add_reload_trigger "network"
}
