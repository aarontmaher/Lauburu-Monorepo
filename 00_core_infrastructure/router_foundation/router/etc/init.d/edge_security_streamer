#!/bin/sh /etc/rc.common
# ==============================================================================
# Lauburu Mesh - Edge Security Packet Streamer procd Service (R5)
# Subsystem: 00_core_infrastructure/router_foundation
# Target: /etc/init.d/edge_security_streamer
#
# Supervises the targeted link-layer tcpdump streamer on port 9005 under procd
# with isolated targeted process control, avoiding collateral termination of socat.
# ==============================================================================

USE_PROCD=1
START=97
STOP=10

PROG="/usr/bin/edge_security_streamer.sh"
NAME="edge_security_streamer"
TCP_PORT="${TCP_PORT:-9005}"

extra_command "check" "Check dependencies and interface status"
extra_command "test_capture" "Run 3-second test capture to verify BPF filter"

start_service() {
    [ -x "$PROG" ] || {
        logger -t "$NAME" "ERROR: $PROG is not executable."
        return 1
    }

    # Verify dependencies and interface existence before launch
    "$PROG" --check >/dev/null 2>&1 || {
        logger -t "$NAME" "ERROR: Pre-flight check failed for $PROG"
        return 1
    }

    procd_open_instance
    procd_set_param command "$PROG" --daemon
    procd_set_param respawn 3600 5 10
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    logger -t "$NAME" "edge_security_streamer procd service started on port $TCP_PORT."
}

stop_service() {
    logger -t "$NAME" "Stopping edge_security_streamer procd service..."
    if [ -x "$PROG" ]; then
        "$PROG" --stop >/dev/null 2>&1 || true
    else
        local target_pids
        target_pids=$(pgrep -f "socat.*$TCP_PORT" 2>/dev/null || true)
        if [ -n "$target_pids" ]; then
            kill -TERM $target_pids 2>/dev/null || true
            sleep 0.5
            kill -9 $target_pids 2>/dev/null || true
        fi
    fi
}

check() {
    if [ -x "$PROG" ]; then
        "$PROG" --check
    else
        echo "ERROR: $PROG not executable" >&2
        return 1
    fi
}

test_capture() {
    if [ -x "$PROG" ]; then
        "$PROG" --test
    else
        echo "ERROR: $PROG not executable" >&2
        return 1
    fi
}

service_triggers() {
    procd_add_reload_trigger "network"
}
