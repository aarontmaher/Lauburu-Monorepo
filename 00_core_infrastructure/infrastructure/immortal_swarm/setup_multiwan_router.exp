#!/usr/bin/expect -f
set timeout 15
spawn ssh -o StrictHostKeyChecking=no root@192.168.8.1
expect "*?assword:*"
send "Goldfighting1\r"
expect "*?root@*"
send "opkg update && opkg install mwan3\r"
expect "*?root@*"
send "uci set mwan3.wan.enabled='1'\r"
send "uci set mwan3.tethering=interface\r"
send "uci set mwan3.tethering.enabled='1'\r"
send "uci set mwan3.tethering.initial_state='online'\r"
send "uci set mwan3.tethering.family='ipv4'\r"
send "uci set mwan3.tethering.track_ip='8.8.8.8'\r"
send "uci set mwan3.tethering.track_ip='1.1.1.1'\r"
send "uci set mwan3.tethering.reliability='1'\r"
send "uci set mwan3.tethering.count='1'\r"
send "uci set mwan3.tethering.timeout='2'\r"
send "uci set mwan3.tethering.interval='5'\r"
send "uci set mwan3.tethering.down='3'\r"
send "uci set mwan3.tethering.up='3'\r"
expect "*?root@*"
send "uci commit mwan3\r"
expect "*?root@*"
send "/etc/init.d/mwan3 restart\r"
expect "*?root@*"
send "mwan3 status\r"
expect "*?root@*"
send "exit\r"
