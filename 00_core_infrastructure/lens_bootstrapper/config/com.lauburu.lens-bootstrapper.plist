<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lauburu.lens-bootstrapper</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Volumes/Lauburu-Monorepo/00_core_infrastructure/lens_bootstrapper/build/lens_bootstrapper</string>
        <string>--foreground</string>
        <string>--config</string>
        <string>/Volumes/Lauburu-Monorepo/00_core_infrastructure/lens_bootstrapper/config/lens_bootstrapper.json</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/Volumes/Lauburu-Monorepo</string>
    <key>StandardOutPath</key>
    <string>/Volumes/Lauburu-Monorepo/logs/lens_bootstrapper.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Volumes/Lauburu-Monorepo/logs/lens_bootstrapper.stderr.log</string>
    <key>ThrottleInterval</key>
    <integer>5</integer>
</dict>
</plist>
