# ==============================================================================
# Lauburu WebGPU & Rust 3D Spatial Specialist Container
# Compiles WGSL shaders, builds Rust WebAssembly bridges, and serves the
# 120 FPS 3D spatial grappling visualizer on Port 8090.
# ==============================================================================
FROM rust:bookworm

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Install dependencies & Node.js
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    python3 \
    python3-pip \
    nodejs \
    npm \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install wasm-pack
RUN curl https://rustwasm.github.io/wasm-pack/installer/init.sh -sSf | sh

WORKDIR /workspace

# Copy launch script
COPY 06_scripts_and_tooling/webgpu_container_entrypoint.sh /usr/local/bin/webgpu_container_entrypoint.sh
RUN chmod +x /usr/local/bin/webgpu_container_entrypoint.sh

EXPOSE 8090

ENTRYPOINT ["/usr/local/bin/webgpu_container_entrypoint.sh"]
