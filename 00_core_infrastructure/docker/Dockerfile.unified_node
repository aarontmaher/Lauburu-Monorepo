# ==============================================================================
# Lauburu Unified Node Container (All-In-One Contributor & Web App Node)
# Bundles:
#   1. Tailscale WireGuard Overlay P2P Mesh (Zero-Config Global Networking)
#   2. ggml-rpc-server Distributed Local AI Inference Engine (Port :50052)
#   3. Movesense 2.0 BLE Showcase & Telemetry Hub (Port :8086)
#   4. OpenClaw Web App & BigAGI Chat UI (Port :8181)
#   5. Dual Membership Gatekeeper & Shopify Storefront Customer Auth
# ==============================================================================
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1
WORKDIR /app

# Install system dependencies, Bluetooth BlueZ DBus, and Tailscale
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    dbus \
    bluez \
    iptables \
    procps \
    net-tools \
    && curl -fsSL https://tailscale.com/install.sh | sh \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements
RUN pip install --no-cache-dir \
    websockets==12.0 \
    httpx==0.27.0 \
    bleak==0.21.1 \
    fastapi==0.110.0 \
    uvicorn==0.29.0 \
    pydantic==2.6.4

# Copy prebuilt rpc-server binary
COPY rpc-server /usr/local/bin/rpc-server
RUN chmod +x /usr/local/bin/rpc-server || true

# Copy Web App, OpenClaw Proxy, and Edge Node Hub services
COPY Standalone_Services/OpenClaw_Environment /app/openclaw
COPY Standalone_Services/Edge_Node_Hub /app/edge_hub

# Entrypoint supervisor
COPY scripts/entrypoint_unified_node.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 8181 8086 50052 18789 6379 7077

CMD ["/app/entrypoint.sh"]
