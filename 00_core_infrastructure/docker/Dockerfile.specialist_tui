# ==============================================================================
# Lauburu Polyglot TUI Specialist Container
# Includes Python (Textual/Rich), Go (Bubble Tea), Rust (Ratatui), C (ncurses),
# ttyd (Port 8088 Web-TUI), and tmux multi-window developer console.
# ==============================================================================
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm-256color
ENV COLORTERM=truecolor
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Install base packages & compiler toolchains
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    clang \
    cmake \
    libncurses5-dev \
    libncursesw5-dev \
    python3 \
    python3-pip \
    python3-dev \
    golang-go \
    curl \
    git \
    tmux \
    ttyd \
    htop \
    jq \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Rust toolchain
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal

# Install Python TUI dependencies
RUN pip3 install --no-cache-dir \
    textual \
    rich \
    textual-web \
    httpx \
    websockets \
    pyyaml

WORKDIR /workspace

# Copy launch script
COPY 06_scripts_and_tooling/tui_container_entrypoint.sh /usr/local/bin/tui_container_entrypoint.sh
RUN chmod +x /usr/local/bin/tui_container_entrypoint.sh

EXPOSE 8088 8089

ENTRYPOINT ["/usr/local/bin/tui_container_entrypoint.sh"]
