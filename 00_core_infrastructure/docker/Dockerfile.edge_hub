# ==============================================================================
# Lauburu Lightweight Edge Hub & Compute Contributor Container
# Contains:
#   1. Movesense BLE Showcase & Ingestion Daemon (Port :8086)
#   2. ggml-rpc-server Distributed AI Compute Pooling Daemon (Port :50052)
#   3. Real-Time Cross-App Biometrics & Trends Engine
# ==============================================================================
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1
WORKDIR /app

# Install minimal Bluetooth DBus and networking dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    dbus \
    bluez \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install lightweight Python dependencies
RUN pip install --no-cache-dir \
    websockets==12.0 \
    bleak==0.21.1 \
    httpx==0.27.0

# Copy RPC Server binary (if available in build context, else downloads prebuilt)
COPY rpc-server /usr/local/bin/rpc-server
RUN chmod +x /usr/local/bin/rpc-server || true

# Copy Edge Node Hub implementation
COPY Standalone_Services/Edge_Node_Hub /app

# Startup Supervisor script running unified node supervisor (RPC + Movesense + Ray/PySpark + Shopify)
RUN echo '#!/bin/sh\n\
echo "🚀 [Unified Edge Node] Starting ggml-rpc-server on port 50052..."\n\
if [ -f "/usr/local/bin/rpc-server" ]; then\n\
    /usr/local/bin/rpc-server -H 0.0.0.0 -p 50052 &\n\
else\n\
    echo "⚠️ rpc-server binary not bundled; local compute pooling running via CPU."\n\
fi\n\
echo "📱 [Unified Edge Node] Starting Unified Supervisor (Movesense + Ray/PySpark + Shopify Auth) on port 8086..."\n\
exec python3 /app/lauburu_node_supervisor.py\n\
' > /app/start_edge_node.sh && chmod +x /app/start_edge_node.sh

EXPOSE 8086 50052 6379 7077

CMD ["/app/start_edge_node.sh"]
