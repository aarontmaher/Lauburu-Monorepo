# ==============================================================================
# 🚀 Position 1: Tailscale tsnet (Embedded Userspace, Zero-Root, No TUN)
# ==============================================================================
FROM golang:1.22-alpine AS builder
WORKDIR /app
COPY go.mod ./
RUN go mod download || true
COPY main_tsnet.go ./
RUN go get tailscale.com@v1.70.0 && CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o tsnet_bench main_tsnet.go

FROM alpine:3.19
RUN adduser -D -u 1001 appuser
WORKDIR /home/appuser
COPY --from=builder /app/tsnet_bench /usr/local/bin/tsnet_bench
USER appuser
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/tsnet_bench"]
