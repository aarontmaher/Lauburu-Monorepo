# Dockerfile for Standalone OpenClaw Chat Suite & FastAPI Proxy
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy python dependencies & install
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt || pip install --no-cache-dir fastapi uvicorn httpx pydantic

# Copy scripts, config, and web_chat_app
COPY scripts /app/scripts
COPY config /app/config
COPY web_chat_app /app/web_chat_app

# Environment defaults
ENV OPENCLAW_PROXY_HOST=0.0.0.0
ENV OPENCLAW_PROXY_PORT=8181
ENV LLAMA_SERVER_URL=http://llama-server:8080
ENV PYTHONPATH=/app

EXPOSE 8181

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8181/health', timeout=4)"

CMD ["uvicorn", "scripts.openclaw_proxy:app", "--host", "0.0.0.0", "--port", "8181", "--timeout-keep-alive", "120", "--limit-concurrency", "100"]
