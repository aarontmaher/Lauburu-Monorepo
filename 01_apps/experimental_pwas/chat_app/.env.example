# Lauburu AI Backend — Environment Variables
#
# Copy to .env and fill in values.
# For Railway/Fly: set these as service environment variables.

# Server port (Railway sets this automatically)
PORT=3000

# Internal API token — protects /v1/internal/* ingest routes.
# Generate a random string. Routes return 503 if not set.
INTERNAL_API_TOKEN=

# Athlete memory API token — protects /api/athlete-memory/* routes.
# Used by the mobile app to read ai-context and ask Coach questions.
# Routes return 503 if not set.
ATHLETE_MEMORY_API_TOKEN=

# WHOOP bridge URL (optional — for live WHOOP data fetch via Supabase edge function)
# Default: https://rejalrfmievikabgsakf.supabase.co/functions/v1/whoop-bridge
# WHOOP_BRIDGE_URL=

# WHOOP MCP direct URL (optional — for sync trigger, bypasses bridge)
# Default: https://whoop-mcp-production-032e.up.railway.app
# WHOOP_MCP_URL=

# Supabase anon key (optional — for WHOOP bridge auth)
# SUPABASE_ANON_KEY=

# Local-first model routing. The edge endpoint is attempted first; failure routes
# to the stronger local Qwen 2.5 Coder 7B model on port 8083. Point these at
# separate local llama.cpp/prima.cpp servers when running both model tiers.
# EDGE_AI_ENDPOINT=http://127.0.0.1:8084/v1/chat/completions
# LOCAL_STRONG_FALLBACK_ENDPOINT=http://127.0.0.1:8083/v1/chat/completions
# LOCAL_STRONG_FALLBACK_MODEL=qwen2.5-coder-7b-instruct-q4_k_m

# Cronometer API credentials (optional — blocked externally)
# When Cronometer offers third-party API access, set these.
# CRONOMETER_API_KEY=
# CRONOMETER_CLIENT_ID=
